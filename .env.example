# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/loopstudy?retryWrites=true&w=majority

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# NVIDIA NIM API (build.nvidia.com) — used for GPT-OSS-120B calls in Phase 2
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-120b

# Resend (email notifications) — used starting Phase 3
RESEND_API_KEY=
EMAIL_FROM=Loopstudy <notifications@yourdomain.com>

# Web Push (VAPID keys for browser push notifications) — used starting Phase 3
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Scheduler — shared secret so only your cron trigger can call the internal review-scan route
CRON_SECRET=
